# Windows 11 指针状态机 —— libinput Lua 插件生成器
#
# 源（本目录 windows-pointer/）：
#   engine.lua   上游 C++ 引擎（github.com/junaga/windows-pointer-linux，
#                BSD-3-Clause）的 Lua 5.4 逐位移植
#   adapter.lua  niri/libinput 适配层
#
# libinput 的插件沙箱没有 require / io / package，所以必须拼成单文件：
#   engine.lua（去掉结尾的 return M）+ adapter.lua
# 与 dotfiles/sources/windows-pointer-niri/build.py 等价，只是把 5 个配置常量
# 交给 Nix 注入（对应 services.windowsPointer.*），不再硬编码在 Lua 里。
{ pkgs, lib }:
let
  toHex =
    n:
    let
      digits = "0123456789abcdef";
      go = v: if v == 0 then "" else go (v / 16) + builtins.substring (v - (v / 16) * 16) 1 digits;
      raw = if n == 0 then "0" else go n;
    in
    "0x" + lib.strings.fixedWidthString 4 "0" raw;

  # 替换一次；找不到就 throw —— 上游改了常量名时要显式失败，不能静默失效。
  # 注意用 hasInfix 而不是「替换后是否变化」：默认值恰好等于原值时后者会误判。
  replaceOnce =
    what: from: to: text:
    if !(lib.hasInfix from text) then
      throw "windows-pointer: ${what} 里找不到「${from}」，adapter.lua 可能改过了"
    else
      lib.replaceStrings [ from ] [ to ] text;

  banner = ''
    -- windows-pointer-niri — generated by nixos-config, do not edit.
    --
    -- Windows 11 desktop pointer state machine for niri, delivered as a
    -- libinput Lua plugin. Engine ported from
    -- github.com/junaga/windows-pointer-linux (BSD-3-Clause).
    --
    -- Sources:    pipeline/windows-pointer/{engine,adapter}.lua
    -- Settings:   services.windowsPointer.*
    -- Installed:  /etc/libinput/plugins/10-windows-pointer.lua
  '';
in
{
  # 生成单文件插件。参数即 adapter.lua 顶部的 5 个配置常量。
  build =
    {
      pointerSpeed,
      enhancePointerPrecision,
      displayDpi,
      vendorId,
      productId,
    }:
    let
      engine = builtins.readFile ./windows-pointer/engine.lua;
      adapter = builtins.readFile ./windows-pointer/adapter.lua;

      engineBody = replaceOnce "engine.lua" "\nreturn M\n" "\n" engine;

      substitutions = [
        {
          what = "POINTER_SPEED";
          from = "local POINTER_SPEED = 10";
          to = "local POINTER_SPEED = ${toString pointerSpeed}";
        }
        {
          what = "ENHANCE_POINTER_PRECISION";
          from = "local ENHANCE_POINTER_PRECISION = true";
          to = "local ENHANCE_POINTER_PRECISION = ${lib.boolToString enhancePointerPrecision}";
        }
        {
          what = "DISPLAY_DPI";
          from = "local DISPLAY_DPI = 96";
          to = "local DISPLAY_DPI = ${toString displayDpi}";
        }
        {
          what = "MATCH_VID";
          from = "local MATCH_VID = 0x04f3";
          to = "local MATCH_VID = ${toHex vendorId}";
        }
        {
          what = "MATCH_PID";
          from = "local MATCH_PID = 0x026f";
          to = "local MATCH_PID = ${toHex productId}";
        }
      ];

      adapterBody = lib.foldl' (text: s: replaceOnce s.what s.from s.to text) adapter substitutions;
    in
    pkgs.writeText "10-windows-pointer.lua" (banner + "\n" + engineBody + "\n" + adapterBody);
}
